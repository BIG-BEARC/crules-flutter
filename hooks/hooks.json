{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/deny-list.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/deny-list.py\"",
            "async": false
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/deny-list.ps1\" || powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/deny-list.ps1\"",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pending-updates.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/pending-updates.py\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-reminder.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-reminder.py\"",
            "async": false
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/compliance-audit.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/compliance-audit.py\"",
            "timeout": 30,
            "async": false
          }
        ]
      }
    ]
  }
}
